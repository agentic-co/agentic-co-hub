# Keep the build context to source. Everything here either does not belong in
# an image or actively must not be in one.
.git
.github
.venv
.pytest_cache
.deepeval
**/__pycache__
*.pyc
tests

# State and secrets. A registry file baked into a layer would ship one team's
# scope claims to whoever pulls the image; a key file baked in would ship the
# secrets that authenticate them.
keys.json
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
work.jsonl
sops.jsonl
*.jsonl.lock
repos/

docs
CONTRIBUTING.md
uv.lock
