__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/
.DS_Store

# The denylist is configuration and is never committed here — a list of real
# names is itself a list of real names. See CONTRIBUTING.md.
leakguard.toml

# Local registry data
*.sqlite3
*.sqlite3-*

# Live stores, never artefacts of the project. `work.jsonl` reached two commits
# through `git add -A` because the default work store is a RELATIVE path, so a
# server or a test started in the repo root writes one here and it looks like a
# source file. A store in a published tree is somebody's queue state on the
# internet.
work.jsonl
sops.jsonl
tasks.jsonl
receipts.jsonl
.agentco/

# Per-developer harness config. `.claude/settings.local.json` is where a  # leakguard: allow
# contributor's own MCP entry and tier-3 session hook land — machine-specific
# absolute paths, and nobody else's business.
# (The allow above is a filename the host rule reads as a hostname, not a host.)
.claude/

# The registry key table: actor -> shared secret, written by `keygen` and
# mounted read-only into the container. A secret in git is a secret in every
# clone and every fork.
keys.json

# per-deployment connector configs — never commit
ado.*.json
routes.*.json

# Eval harness output: trial ledgers, SOP stores and run artifacts. Results are
# reproducible from the task set and the ledger is large, machine-local, and
# carries whatever a model happened to emit — including its mistakes verbatim.
evals-out/

# The eval fleet's own config: proxy URL, virtual key, model names. The proxy
# hostname alone names an employer, which is exactly the class of thing that
# keeps this repo publishable when it stays out of the tree.
evals/.env.eval
