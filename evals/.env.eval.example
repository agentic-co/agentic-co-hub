# Copy to `evals/.env.eval` (gitignored) and fill in. Then: `set -a; . evals/.env.eval; set +a`
#
# Nothing here is committed, and the reason is the same rule the whole repo is
# extracted under: a proxy hostname names an organisation, and anything naming
# an organisation is configuration, not code.

# --- routing -----------------------------------------------------------------
# A LiteLLM proxy, or leave unset to call vendors directly with their own keys.
AGENTCO_EVAL_API_BASE=https://litellm.example.com
AGENTCO_EVAL_API_KEY=sk-...

# Deployment names as the PROXY knows them, not vendor model ids. A bare name
# is routed as `litellm_proxy/<name>` automatically; write an explicit
# `anthropic/…` prefix to bypass the proxy for one role.
#
# These MUST differ. A judged gate graded by the executor's own route measures
# agreement, not quality — ASOP Part I forbids it and `Fleet.load()` refuses it.
# Different vendors is better than different models from one vendor.
AGENTCO_EVAL_EXECUTOR=
AGENTCO_EVAL_JUDGE=

# --- spend -------------------------------------------------------------------
# Client-side cap, checked BEFORE each call. Set `max_budget` on the virtual key
# as well: this one cannot survive a crash, a second process, or a bug in itself.
AGENTCO_EVAL_BUDGET_USD=25
